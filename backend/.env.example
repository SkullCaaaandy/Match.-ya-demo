# Configuración de base de datos PostgreSQL en Supabase
DATABASE_URL="postgresql://postgres:[CONTRASEÑA]@db.[ID_PROYECTO].supabase.co:5432/postgres"

# Credenciales de Supabase
SUPABASE_URL="https://[ID_PROYECTO].supabase.co"
SUPABASE_KEY="[TU_SUPABASE_KEY]"

# Puerto del servidor backend
PORT=3000
